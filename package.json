{
    "name": "trpicker",
    "version": "1.1.2",
    "description": "基于 SVG 的圆形时间范围选择器，支持 24/12 小时制",
    "license": "MIT",
    "author": "Limpo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/limpochen/trpicker.git"
    },
    "keywords": [
        "time-picker",
        "time-range",
        "svg",
        "clock",
        "picker"
    ],
    "main": "./dist/trpicker.js",
    "module": "./dist/trpicker.mjs",
    "types": "./dist/trpicker.d.ts",
    "unpkg": "./dist/trpicker.iife.js",
    "jsdelivr": "./dist/trpicker.iife.js",
    "exports": {
        ".": {
            "types": "./dist/trpicker.d.ts",
            "import": "./dist/trpicker.mjs",
            "require": "./dist/trpicker.js",
            "default": "./dist/trpicker.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node build.js",
        "start": "node server.js"
    },
    "devDependencies": {
        "esbuild": "^0.19.12"
    }
}
